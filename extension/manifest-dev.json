{
  "manifest_version": 3,
  "version": "1.0.1",
  "name": "Row Fixer Plus",
  "description": "Customise your YouTube grid, hide Shorts and Playables, and enjoy a cleaner feed with your own layout.",
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://www.youtube.com/*"
  ],
  "background": {
    "service_worker": "src/background/background.js"
  },
  "action": {
    "default_title": "Row Fixer Plus",
    "default_icon": "public/images/row-fixer-plus-32.png",
    "default_popup": "index.html"
  },
  "icons": {
    "16": "public/images/row-fixer-plus-16.png",
    "32": "public/images/row-fixer-plus-32.png",
    "48": "public/images/row-fixer-plus-48.png",
    "64": "public/images/row-fixer-plus-64.png",
    "128": "public/images/row-fixer-plus-128.png"
  },
  "content_scripts": [
    {
      "run_at": "document_start",
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "src/content-scripts/main.js"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "matches": [
        "<all_urls>"
      ],
      "resources": [
        "**/*",
        "*"
      ],
      "use_dynamic_url": true
    }
  ]
}
