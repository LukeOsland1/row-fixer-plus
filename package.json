{
  "name": "row-fixer-plus",
  "version": "1.2.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "test": "playwright test",
    "build": "npm run lint && vite build --config vite.build.config.mjs && webpack --mode production && node utils/build.js",
    "zip": "node utils/zip.js",
    "prettier": "prettier --write src/**/*.{js,jsx,ts,tsx,css,scss}",
    "lint": "eslint src utils tests *.js *.mjs",
    "lint:firefox": "node utils/lint-firefox.mjs",
    "version": "node utils/sync-version.mjs",
    "check:version": "node utils/sync-version.mjs --check",
    "release:prepare": "node utils/release.mjs prepare",
    "release:verify": "node utils/release.mjs verify",
    "release:submit": "node utils/submit-store.mjs",
    "screenshots": "node utils/screenshots.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.7.1",
    "@playwright/test": "1.63.0",
    "@vitejs/plugin-react": "^6.1.1",
    "addons-linter": "10.13.0",
    "adm-zip": "^0.6.1",
    "autoprefixer": "^10.4.19",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.0.0",
    "postcss": "^8.5.23",
    "prettier": "^3.8.0",
    "tailwindcss": "^3.4.19",
    "vite": "^8.3.0",
    "web-ext": "10.7.0",
    "webpack": "^5.111.1",
    "webpack-cli": "^7.2.3"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
